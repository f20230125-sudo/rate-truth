# Optional local configuration. No keys are needed for M0/M1.
RATE_TRUTH_SEED=2026
RATE_TRUTH_ORIGIN=http://localhost:8000
# Provider A (Xotelo) needs no key. Provider B is optional.
SERPAPI_API_KEY=
# Default production docs are disabled; opt in locally if needed.
RATE_TRUTH_ENV=production
# M4: only live LLM calls need keys. Offline mode still executes real local MCP tools.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Eval-only local quota guardrails; provider quotas may be lower.
# GEMINI_LIMITS='{"rpm":10,"tpm":120000,"rpd":200,"tpd":1000000}'
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Optional REST timeout override (seconds); defaults: web 9, eval/recorder 15.
# RATE_TRUTH_LLM_TIMEOUT_S=15
# RATE_TRUTH_LLM_MODE=replay
# RATE_TRUTH_RETRIEVAL=bm25
RATE_TRUTH_PUBLIC_API_URL=http://127.0.0.1:8170
# Production MCP DNS-rebinding allowlist: comma-separated exact Host values.
# RATE_TRUTH_MCP_HOSTS=your-api.vercel.app,your-site.vercel.app
# RATE_TRUTH_HOSTS=your-api.vercel.app,*.vercel.app
# Shared across instances; unset uses a random development-only process secret.
# RATE_TRUTH_SECRET=replace-with-a-long-random-secret
# Enable only when direct access is restricted to your trusted reverse proxy.
RATE_TRUTH_TRUST_PROXY=false
# Optional shared durable writable market directory. Local default: data/market.
# RATE_TRUTH_MARKET_DIR=/persistent/rate-truth/market
# Set true only if this directory is genuinely persistent and shared across workers.
# RATE_TRUTH_MARKET_PERSISTENT=true
