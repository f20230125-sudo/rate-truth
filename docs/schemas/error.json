{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "StreamError": {
      "properties": {
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "retry_after_s": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Retry After S"
        },
        "field": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Field"
        },
        "rule": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "StreamError",
      "type": "object"
    }
  },
  "properties": {
    "error": {
      "$ref": "#/$defs/StreamError"
    }
  },
  "required": [
    "error"
  ],
  "title": "Error",
  "type": "object"
}
