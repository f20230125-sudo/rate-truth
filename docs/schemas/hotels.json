{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Folio": {
      "properties": {
        "rate_id": {
          "title": "Rate Id",
          "type": "string"
        },
        "computed_at": {
          "format": "date-time",
          "title": "Computed At",
          "type": "string"
        },
        "hotel_id": {
          "title": "Hotel Id",
          "type": "string"
        },
        "hotel_name": {
          "title": "Hotel Name",
          "type": "string"
        },
        "checkin": {
          "format": "date",
          "title": "Checkin",
          "type": "string"
        },
        "nights": {
          "maximum": 30,
          "minimum": 1,
          "title": "Nights",
          "type": "integer"
        },
        "guests": {
          "maximum": 8,
          "minimum": 1,
          "title": "Guests",
          "type": "integer"
        },
        "room": {
          "title": "Room",
          "type": "string"
        },
        "plan": {
          "title": "Plan",
          "type": "string"
        },
        "refundable": {
          "title": "Refundable",
          "type": "boolean"
        },
        "breakfast": {
          "title": "Breakfast",
          "type": "boolean"
        },
        "lines": {
          "items": {
            "$ref": "#/$defs/Line"
          },
          "title": "Lines",
          "type": "array"
        },
        "total": {
          "pattern": "^-?\\d+\\.\\d{2}$",
          "title": "Total",
          "type": "string"
        },
        "currency": {
          "const": "AED",
          "title": "Currency",
          "type": "string"
        },
        "tax_rules_as_of": {
          "format": "date",
          "title": "Tax Rules As Of",
          "type": "string"
        },
        "synthetic": {
          "const": true,
          "title": "Synthetic",
          "type": "boolean"
        }
      },
      "required": [
        "rate_id",
        "computed_at",
        "hotel_id",
        "hotel_name",
        "checkin",
        "nights",
        "guests",
        "room",
        "plan",
        "refundable",
        "breakfast",
        "lines",
        "total",
        "currency",
        "tax_rules_as_of",
        "synthetic"
      ],
      "title": "Folio",
      "type": "object"
    },
    "HotelRow": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "osm_id": {
          "title": "Osm Id",
          "type": "string"
        },
        "osm_type": {
          "enum": [
            "node",
            "way",
            "relation"
          ],
          "title": "Osm Type",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "name_en": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Name En"
        },
        "mapped_osm_ids": {
          "items": {
            "type": "string"
          },
          "title": "Mapped Osm Ids",
          "type": "array"
        },
        "lat": {
          "maximum": 90,
          "minimum": -90,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180,
          "minimum": -180,
          "title": "Lon",
          "type": "number"
        },
        "area": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Area"
        },
        "stars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stars"
        },
        "stars_estimated": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stars Estimated"
        },
        "stars_method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stars Method"
        },
        "website": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Website"
        },
        "nearest_metro": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ]
        },
        "nearest_beach": {
          "anyOf": [
            {
              "$ref": "#/$defs/Place"
            },
            {
              "type": "null"
            }
          ]
        },
        "landmarks": {
          "items": {
            "$ref": "#/$defs/Place"
          },
          "title": "Landmarks",
          "type": "array"
        },
        "from_folio": {
          "anyOf": [
            {
              "$ref": "#/$defs/Folio"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "osm_id",
        "osm_type",
        "name",
        "name_en",
        "mapped_osm_ids",
        "lat",
        "lon",
        "area",
        "stars",
        "stars_estimated",
        "stars_method",
        "website",
        "nearest_metro",
        "nearest_beach",
        "landmarks",
        "from_folio"
      ],
      "title": "HotelRow",
      "type": "object"
    },
    "Line": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "amount": {
          "pattern": "^-?\\d+\\.\\d{2}$",
          "title": "Amount",
          "type": "string"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "base",
            "tax",
            "fee",
            "discount"
          ],
          "title": "Kind",
          "type": "string"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Basis"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        },
        "confidence": {
          "anyOf": [
            {
              "enum": [
                "official",
                "secondary",
                "uncertain"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        }
      },
      "required": [
        "label",
        "amount",
        "rule_id",
        "kind"
      ],
      "title": "Line",
      "type": "object"
    },
    "Place": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "metres": {
          "minimum": 0,
          "title": "Metres",
          "type": "number"
        }
      },
      "required": [
        "name",
        "metres"
      ],
      "title": "Place",
      "type": "object"
    }
  },
  "properties": {
    "total": {
      "minimum": 0,
      "title": "Total",
      "type": "integer"
    },
    "items": {
      "items": {
        "$ref": "#/$defs/HotelRow"
      },
      "title": "Items",
      "type": "array"
    }
  },
  "required": [
    "total",
    "items"
  ],
  "title": "Hotels",
  "type": "object"
}
