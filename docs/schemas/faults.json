{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "Fault": {
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "google_reason": {
          "title": "Google Reason",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/Source"
          },
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "description",
        "google_reason",
        "sources"
      ],
      "title": "Fault",
      "type": "object"
    },
    "Source": {
      "properties": {
        "label": {
          "title": "Label",
          "type": "string"
        },
        "url": {
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "title": "Source",
      "type": "object"
    }
  },
  "items": {
    "$ref": "#/$defs/Fault"
  },
  "title": "Faults",
  "type": "array"
}
