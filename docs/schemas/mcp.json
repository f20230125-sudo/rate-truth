{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "jsonrpc": {
      "const": "2.0",
      "title": "Jsonrpc",
      "type": "string"
    },
    "id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Id"
    },
    "result": {
      "default": null,
      "title": "Result"
    },
    "error": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Error"
    }
  },
  "required": [
    "jsonrpc",
    "id"
  ],
  "title": "MCPResponse",
  "type": "object"
}
